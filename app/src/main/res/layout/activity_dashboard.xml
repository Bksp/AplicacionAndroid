<?xml version="1.0" encoding="utf-8"?>
<!-- Raíz estándar: ConstraintLayout con soporte DayNight -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ScrollView para la lista de integrantes -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Título de la pantalla -->
            <TextView
                android:id="@+id/tv_titulo_dash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dash_titulo"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- TARJETA SIMULADA 1 (Mantiene el ID del botón de tu compañero) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_simulada_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/verde_claro"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/tv_titulo_dash">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_perfil_1"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/verde_claro"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_nombre_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_nombre_1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/iv_perfil_1"
                        app:layout_constraintStart_toEndOf="@id/iv_perfil_1"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_rol_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_rol_1"
                        android:textColor="@color/verde_claro"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_nombre_1"
                        app:layout_constraintStart_toStartOf="@id/tv_nombre_1" />

                    <TextView
                        android:id="@+id/tv_exp_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_exp_1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_rol_1"
                        app:layout_constraintStart_toStartOf="@id/tv_nombre_1" />

                    <!-- ID clave que conectó tu compañero -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reproducir_audio_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/dash_btn_reproducir"
                        app:icon="@android:drawable/ic_media_play"
                        app:backgroundTint="@color/verde_institucional"
                        app:layout_constraintTop_toBottomOf="@id/tv_exp_1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA SIMULADA 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_simulada_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/verde_claro"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/card_simulada_1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_perfil_2"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/verde_claro"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_nombre_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_nombre_2"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="@id/iv_perfil_2"
                        app:layout_constraintStart_toEndOf="@id/iv_perfil_2"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_rol_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_rol_2"
                        android:textColor="@color/verde_claro"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_nombre_2"
                        app:layout_constraintStart_toStartOf="@id/tv_nombre_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reproducir_audio_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/dash_btn_reproducir"
                        app:icon="@android:drawable/ic_media_play"
                        app:backgroundTint="@color/verde_institucional"
                        app:layout_constraintTop_toBottomOf="@id/tv_rol_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Botón Flotante anclado a la esquina inferior derecha -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_agregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/verde_institucional"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>