<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_reproductor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:title="@string/reproduciendo_audio"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/spacing_large">

        <!-- Placeholder Gráfico Central -->
        <ImageView
            android:id="@+id/iv_icono_audio"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="?attr/colorSecondary"
            android:layout_marginTop="@dimen/spacing_large"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Barra de progreso -->
        <ProgressBar
            android:id="@+id/pb_repro_progreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="?attr/colorPrimary"
            android:layout_marginTop="@dimen/spacing_extra_large"
            app:layout_constraintTop_toBottomOf="@id/iv_icono_audio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Texto de Tiempo/Duración del Audio -->
        <TextView
            android:id="@+id/tv_repro_tiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 / 00:00"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/spacing_tiny"
            app:layout_constraintTop_toBottomOf="@id/pb_repro_progreso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Control Principal de Audio: Botón Único Centralizado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_repro_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/input_min_height"
            android:text="Reproducir"
            app:icon="@android:drawable/ic_media_play"
            app:cornerRadius="@dimen/card_corner_radius"
            app:backgroundTint="?attr/colorPrimary"
            android:layout_marginTop="@dimen/spacing_medium"
            app:layout_constraintTop_toBottomOf="@id/tv_repro_tiempo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón Cerrar (Anclado al fondo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_repro_close"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_cerrar_reproductor"
            app:cornerRadius="@dimen/card_corner_radius"
            app:backgroundTint="?attr/colorSecondary"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
