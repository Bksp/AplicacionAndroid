<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_registro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:title="@string/registro_titulo"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_medium">

            <!-- TARJETA 0: Datos Personales -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_datos_personales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/card_stroke_width"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_card">

                    <TextView
                        android:id="@+id/tv_label_datos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro_datos"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_nombre"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_datos">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_nombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/registro_nombre"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_apellido"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:layout_constraintTop_toBottomOf="@id/til_nombre">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_apellido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/registro_apellido"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_correo"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:layout_constraintTop_toBottomOf="@id/til_apellido">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_correo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/registro_correo"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 1: Rol y Experiencia -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_rol_exp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/card_stroke_width"
                app:layout_constraintTop_toBottomOf="@id/card_datos_personales">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_card">

                    <TextView
                        android:id="@+id/tv_label_rol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro_rol"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_rol"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_rol">

                        <AutoCompleteTextView
                            android:id="@+id/spn_rol"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_seleccione_rol"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_label_exp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/registro_experiencia"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/til_rol"
                        app:layout_constraintStart_toStartOf="parent" />

                    <RadioGroup
                        android:id="@+id/rg_experiencia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_exp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <RadioButton
                            android:id="@+id/rb_junior"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="?attr/colorPrimary"
                            android:text="@string/registro_exp_jr"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rb_mid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="?attr/colorPrimary"
                            android:text="@string/registro_exp_mid"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rb_senior"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="?attr/colorPrimary"
                            android:text="@string/registro_exp_sr"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </RadioGroup>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 2: Habilidades y Métrica -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_habilidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/card_stroke_width"
                app:layout_constraintTop_toBottomOf="@id/card_rol_exp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_card">

                    <TextView
                        android:id="@+id/tv_label_hab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro_habilidades"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Fila 1 de habilidades -->
                    <CheckBox
                        android:id="@+id/cb_java"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/registro_hab_java"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_hab"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cb_xml" />

                    <CheckBox
                        android:id="@+id/cb_xml"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/registro_hab_xml"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintTop_toTopOf="@id/cb_java"
                        app:layout_constraintStart_toEndOf="@id/cb_java"
                        app:layout_constraintEnd_toStartOf="@id/cb_git" />

                    <CheckBox
                        android:id="@+id/cb_git"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/registro_hab_git"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintTop_toTopOf="@id/cb_java"
                        app:layout_constraintStart_toEndOf="@id/cb_xml"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Fila 2 de habilidades -->
                    <CheckBox
                        android:id="@+id/cb_android"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/registro_hab_android"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintTop_toBottomOf="@id/cb_java"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cb_mvvm" />

                    <CheckBox
                        android:id="@+id/cb_mvvm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/colorPrimary"
                        android:text="@string/registro_hab_mvvm"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintTop_toTopOf="@id/cb_android"
                        app:layout_constraintStart_toEndOf="@id/cb_android"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_label_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/registro_valoracion"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/cb_android"
                        app:layout_constraintStart_toStartOf="parent" />

                    <RatingBar
                        android:id="@+id/rb_valoracion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:numStars="5"
                        android:stepSize="1"
                        android:progressTint="?attr/colorPrimary"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_val"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 3: Captura de Audio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_captura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_large"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/card_stroke_width"
                app:layout_constraintTop_toBottomOf="@id/card_habilidades"
                app:layout_constraintBottom_toTopOf="@id/btn_guardar">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_card">

                    <TextView
                        android:id="@+id/tv_label_captura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro_captura"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.ipst.registromultimedia.VisualizarOndas
                        android:id="@+id/visualizador"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/audio_visualizer_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_captura"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_iniciar_grabacion"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/input_min_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:text="@string/registro_btn_iniciar"
                        app:icon="@android:drawable/ic_btn_speak_now"
                        app:cornerRadius="@dimen/card_corner_radius"
                        app:backgroundTint="?attr/colorPrimary"
                        app:rippleColor="?attr/colorSecondary"
                        app:layout_constraintTop_toBottomOf="@id/visualizador"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btn_detener_grabacion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detener_grabacion"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/input_min_height"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="@string/registro_btn_detener"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/card_corner_radius"
                        app:icon="@drawable/ic_stop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btn_iniciar_grabacion"
                        app:layout_constraintTop_toTopOf="@id/btn_iniciar_grabacion"
                        app:rippleColor="?attr/colorSecondary"
                        app:strokeColor="?attr/colorPrimary" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón principal de guardado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:text="@string/registro_btn_guardar"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                app:cornerRadius="@dimen/card_corner_radius"
                app:backgroundTint="?attr/colorPrimary"
                app:rippleColor="?attr/colorSecondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
